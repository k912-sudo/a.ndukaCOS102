   "source": [
    "import tkinter as tk\n",
    "from tkinter import messagebox\n",
    "import pandas as pd\n",
    "\n",
    "def check_employee():\n",
    "    name = entry_name.get().strip()\n",
    "    department = entry_dept.get().strip()\n",
    "\n",
    "    try:\n",
    "        # Load the dataset\n",
    "        df = pd.read_csv('GIG-logistics.csv')\n",
    "        \n",
    "        # Check if the employee exists in the specified department\n",
    "        # Assumes CSV columns are 'NAME' and 'DEPARTMENT'\n",
    "        match = df[(df['NAME'].str.lower() == name.lower()) & \n",
    "                   (df['DEPARTMENT'].str.lower() == department.lower())]\n",
    "\n",
    "        if not match.empty:\n",
    "            # Get other members of the same department\n",
    "            others = df[df['DEPARTMENT'].str.lower() == department.lower()]\n",
    "            other_names = others['NAME'].tolist()\n",
    "            \n",
    "            welcome_msg = f\"Welcome, {name}!\\n\\nOther members in {department}:\\n\"\n",
    "            welcome_msg += \"\\n\".join(other_names)\n",
    "            messagebox.showinfo(\"Success\", welcome_msg)\n",
    "        else:\n",
    "            messagebox.showwarning(\"Not Found\", \"Employee does not exist in that department.\")\n",
    "\n",
    "    except FileNotFoundError:\n",
    "        messagebox.showerror(\"Error\", \"GIG-logistics.csv file not found.\")\n",
    "\n",
    "# GUI Setup\n",
    "root = tk.Tk()\n",
    "root.title(\"GIG Logistics Verification\")\n",
    "root.geometry(\"300x200\")\n",
    "\n",
    "tk.Label(root, text=\"Name:\").pack(pady=5)\n",
    "entry_name = tk.Entry(root)\n",
    "entry_name.pack()\n",
    "\n",
    "tk.Label(root, text=\"Department:\").pack(pady=5)\n",
    "entry_dept = tk.Entry(root)\n",
    "entry_dept.pack()\n",
    "\n",
    "tk.Button(root, text=\"Verify\", command=check_employee).pack(pady=20)\n",
    "\n",
    "root.mainloop()"
   ]
  },
